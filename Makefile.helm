# ============================================================
# Sync Seat Helm Makefile
# ============================================================

NAMESPACE := sync-seat
HELM := helm
CHART_DIR := helm/syncseat/charts

# ============================================================
# Infrastructure
# ============================================================

infra: postgres redis 

postgres:
	$(HELM) upgrade --install postgres $(CHART_DIR)/postgres -n $(NAMESPACE)

redis:
	$(HELM) upgrade --install redis $(CHART_DIR)/redis -n $(NAMESPACE)



# ============================================================
# Application Services
# ============================================================

microservices: booking mail homepage api-gateway

booking:
	$(HELM) upgrade --install booking $(CHART_DIR)/booking -n $(NAMESPACE)

mail:
	$(HELM) upgrade --install mail $(CHART_DIR)/mail -n $(NAMESPACE)

homepage:
	$(HELM) upgrade --install homepage $(CHART_DIR)/homepage -n $(NAMESPACE)

api-gateway:
	$(HELM) upgrade --install api-gateway $(CHART_DIR)/api-gateway -n $(NAMESPACE)

# ============================================================
# Front-end React apps
# ============================================================

frontend:
	$(HELM) upgrade --install frontend $(CHART_DIR)/frontend -n $(NAMESPACE)

# ============================================================
# Full Deployment
# ============================================================

all: infra microservices frontend

# ============================================================
# Utilities
# ============================================================

pods:
	kubectl get pods -n $(NAMESPACE)

svc:
	kubectl get svc -n $(NAMESPACE)

deploy:
	kubectl get deployments -n $(NAMESPACE)

cm:
	kubectl get configmaps -n $(NAMESPACE)

pvc:
	kubectl get pvc -n $(NAMESPACE)

events:
	kubectl get events -n $(NAMESPACE) --sort-by=.metadata.creationTimestamp

# ============================================================
# Logs
# ============================================================

logs-catalog:
	kubectl logs deployment/catalog -n $(NAMESPACE) --tail=100

logs-user:
	kubectl logs deployment/user -n $(NAMESPACE) --tail=100

logs-order:
	kubectl logs deployment/order -n $(NAMESPACE) --tail=100

logs-payment:
	kubectl logs deployment/payment -n $(NAMESPACE) --tail=100

logs-cart:
	kubectl logs deployment/cart -n $(NAMESPACE) --tail=100

logs-shipping:
	kubectl logs deployment/shipping -n $(NAMESPACE) --tail=100

logs-courier:
	kubectl logs deployment/courier -n $(NAMESPACE) --tail=100

# ============================================================
# Cleanup
# ============================================================

clean-app:
	-helm uninstall booking -n $(NAMESPACE)
	-helm uninstall api-gateway -n $(NAMESPACE)
	-helm uninstall mail -n $(NAMESPACE)
	-helm uninstall homepage -n $(NAMESPACE)
	

clean-infra:
	-helm uninstall postgres -n $(NAMESPACE)
	-helm uninstall redis -n $(NAMESPACE)
	

clean-web:
	-helm uninstall frontend -n $(NAMESPACE)
	
clean:  clean-infra clean-app clean-web
# ============================================================
# Helm Validation
# ============================================================

lint-booking:
	helm lint $(CHART_DIR)/booking

template-booking:
	helm template booking $(CHART_DIR)/booking

lint-postgres:
	helm lint $(CHART_DIR)/postgres

template-postgres:
	helm template postgres $(CHART_DIR)/postgres

# ============================================================
# Help
# ============================================================

help:
	@echo ""
	@echo "Infrastructure:"
	@echo "  make -f Makefile.helm infra"
	@echo ""
	@echo "Application:"
	@echo "  make -f Makefile.helm catalog"
	@echo "  make -f Makefile.helm user"
	@echo "  make -f Makefile.helm order"
	@echo ""
	@echo "Deploy everything:"
	@echo "  make -f Makefile.helm all"
	@echo ""
	@echo "Status:"
	@echo "  make -f Makefile.helm pods"
	@echo "  make -f Makefile.helm svc"
	@echo "  make -f Makefile.helm deploy"
	@echo ""
	@echo "Cleanup:"
	@echo "  make -f Makefile.helm clean"
	@echo ""

# ============================================================
# Install Beer-shop
# ============================================================

install-sync-seat:
	helm upgrade --install sync-seat \
	helm/syncseat \
	-n sync-seat

install-sync-seat-dev:
	helm upgrade --install sync-seat \
	helm/syncseat \
	-f helm/syncseat/values-dev.yaml \
	-n sync-seat

install-sync-seat-prod:
	helm upgrade --install sync-seat \
	helm/syncseat \
	-f helm/syncseat/values-prod.yaml \
	-n sync-seat

# ============================================================
# CI Validation
# ============================================================

helm-lint:
	$(HELM) lint helm/syncseat

helm-template:
	$(HELM) template sync-seat helm/syncseat \
		-f helm/syncseat/values-dev.yaml \
		> /tmp/sync-seat-rendered.yaml

# ============================================================
# Kubernetes Manifest Validation
# ============================================================

k8s-validate:
	$(HELM) template sync-seat helm/syncseat \
		-f helm/syncseat/values-dev.yaml \
		| kubeconform -strict -summary

helm-validate: helm-lint helm-template k8s-validate
	@echo "Helm and Kubernetes validation passed"